<div class="min-h-screen bg-slate-900 text-white flex items-center justify-center">
  <div class="text-center max-w-2xl px-4">
    <h1 class="text-6xl font-bold mb-4"><%= @title %></h1>
    <p class="text-slate-400 text-xl mb-8"><%= @subtitle %></p>
    
    <div class="flex flex-wrap gap-2 justify-center">
      <% @tech.each do |t| %>
        <span class="px-3 py-1 bg-slate-800 rounded-full text-sm"><%= t %></span>
      <% end %>
    </div>
  </div>
</div>